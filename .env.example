# =============================================================================
# LinkedIn AI Content Automation - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- n8n -------------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# The Code nodes hash with node:crypto; n8n requires builtins to be allow-listed.
NODE_FUNCTION_ALLOW_BUILTIN=crypto
# Set a long random string. Encrypts stored credentials; losing it orphans them.
N8N_ENCRYPTION_KEY=

# --- Google Sheets ---------------------------------------------------------
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Automation

# --- Sheet access via Apps Script (the default path) -----------------------
# The /exec URL of the Apps Script web app deployed from apps-script/Code.gs.
SHEET_API_URL=
# Shared secret. MUST match TOKEN in apps-script/Code.gs. Use 32+ random chars:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SHEET_API_TOKEN=

# --- Google OAuth (only for the optional n8n path) -------------------------
# Not needed when using Apps Script above. Filled by scripts/google-auth.js.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
# Free text tier + Google Search grounding. Verify current free status before changing.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- Claude fallback (optional, PAID) --------------------------------------
# Used only when Gemini fails. Leave EMPTY to disable the fallback entirely.
# There is no search grounding on this path, so every URL is stripped.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- LinkedIn --------------------------------------------------------------
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Stored as an n8n OAuth2 credential. Only set here if you manage tokens manually.
LINKEDIN_ACCESS_TOKEN=
# YYYYMM. Verify against the current Posts API docs before changing.
LINKEDIN_API_VERSION=202609
# Filled automatically by scripts/linkedin-me.js, or paste urn:li:person:xxxx
LINKEDIN_AUTHOR_URN=

# --- Local image service ---------------------------------------------------
IMAGE_SERVICE_HOST=0.0.0.0
IMAGE_SERVICE_PORT=8411
# Optional shared secret. Set one if this machine is not on a trusted network.
IMAGE_SERVICE_TOKEN=
IMAGE_OUTPUT_DIR=
# URL n8n uses to reach the image service.
# Docker:  http://host.docker.internal:8411
# npm/npx: http://127.0.0.1:8411
IMAGE_SERVICE_URL=http://host.docker.internal:8411

# --- ComfyUI (optional; off by default on machines without a discrete GPU) ---
COMFYUI_ENABLED=false
COMFYUI_URL=
COMFYUI_TIMEOUT_MS=180000

# --- Behaviour -------------------------------------------------------------
# Master switch. Leave false until the acceptance tests pass (spec Phase 10).
AUTO_PUBLISH=false
ENABLE_RESEARCH=true
ENABLE_IMAGE=true
TIMEZONE=Asia/Kolkata
# Minutes before an in-flight row is considered abandoned and may be reclaimed.
STALE_MINUTES=30
# Attempts before a row is parked as Failed.
MAX_ATTEMPTS=3
# Publish more than one row per day when several are due.
ALLOW_MULTIPLE_PER_DAY=false
