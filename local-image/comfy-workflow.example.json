{
  "_comment": [
    "EXAMPLE ONLY - copy to comfy-workflow.json and replace with YOUR exported workflow.",
    "In ComfyUI: build the workflow, then Save (API Format). Put {{PLACEHOLDERS}} where",
    "you want values injected. lib/comfy.js substitutes:",
    "  {{PROMPT}} {{NEGATIVE}} {{SEED}} {{WIDTH}} {{HEIGHT}}",
    "A placeholder alone in a numeric field is converted to a number automatically.",
    "Node ids and class_type names below must match the model/nodes YOU installed."
  ],
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "REPLACE_WITH_YOUR_CHECKPOINT.safetensors" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{PROMPT}}", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE}}", "clip": ["4", 1] }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 8,
      "cfg": 2.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "linkedin", "images": ["8", 0] }
  }
}
